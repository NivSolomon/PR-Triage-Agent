<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="pr-triage-architecture" name="PR Triage Agent">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PR Triage Agent — architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Answers from live GitHub data. Posts a comment only after a human approves that exact text." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="32" width="780" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ch-label" value="CHANNELS (who may do what)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="240" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="slack" value="&lt;b&gt;Slack app&lt;/b&gt;&lt;br&gt;/triage, DMs, @mentions&lt;br&gt;queue | digest | budget | pending&lt;br&gt;&lt;font color='#15803d'&gt;&lt;b&gt;Approve / Reject&lt;/b&gt; (approver IDs only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="84" width="230" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="web" value="&lt;b&gt;Web page&lt;/b&gt;&lt;br&gt;chat, ranked queue, approvals&lt;br&gt;key once, then session cookie&lt;br&gt;&lt;font color='#15803d'&gt;&lt;b&gt;Approver key / WEB_USERS&lt;/b&gt;: Approve / Reject&lt;/font&gt;&lt;br&gt;wrong keys throttled (or off)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="196" width="230" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="mcp" value="&lt;b&gt;MCP clients (other agents)&lt;/b&gt;&lt;br&gt;POST /mcp, bearer token&lt;br&gt;reader: read + ask&lt;br&gt;proposer: also create a request&lt;br&gt;&lt;font color='#b91c1c'&gt;&lt;b&gt;no role can approve or post&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="322" width="230" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="mcp-note" value="MCP and the access key cannot&lt;br&gt;reach the approve action." style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="20" y="436" width="230" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="container" value="ONE CONTAINER (Node 22, TypeScript) — single instance" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="280" y="84" width="540" height="460" as="geometry"/>
        </mxCell>

        <mxCell id="handlers" value="&lt;b&gt;Channel handlers&lt;/b&gt;&lt;br&gt;authenticate, validate, escape + plain text only (PR text is untrusted)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="16" y="36" width="508" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Agent (LLM tool loop)&lt;/b&gt;&lt;br&gt;1. budget gate (normal / economy / blocked)&lt;br&gt;2. model picks a tool (max 4 rounds)&lt;br&gt;3. tool results come back; PR text marked untrusted&lt;br&gt;4. answer: facts, why, confidence, source links&lt;br&gt;5. grounding check: every #number must be fetched&lt;br&gt;6. strip Markdown, log usage and cost&lt;br&gt;&lt;font color='#b91c1c'&gt;no approve tool; propose_comment needs permission&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff4c2;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="16" y="96" width="320" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="tools" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;get_review_queue&lt;br&gt;get_pull_request&lt;br&gt;propose_comment" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="352" y="96" width="172" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="triage" value="&lt;b&gt;Triage engine&lt;/b&gt;&lt;br&gt;deterministic score + state&lt;br&gt;unknowns lower confidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="352" y="186" width="172" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="approval" value="&lt;b&gt;Approval service — the ONLY writer&lt;/b&gt;&lt;br&gt;propose: stores pending row, never writes to GitHub&lt;br&gt;approve: isApprover check, atomic pending→executing&lt;br&gt;posts the STORED text; marker finds a half-failed post&lt;br&gt;24h expiry, max 20 pending" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="16" y="258" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="scheduler" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;weekday digest (cron)&lt;br&gt;no model, no AI cost" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="352" y="258" width="172" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="budget" value="&lt;b&gt;Budget guard&lt;/b&gt;&lt;br&gt;$50/mo incl. hosting&lt;br&gt;economy 80%, stop 100%" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="352" y="324" width="172" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="sqlite" value="&lt;b&gt;SQLite on a mounted volume (/data)&lt;/b&gt;&lt;br&gt;pending_actions: every proposal, decision, who decided, result or error&lt;br&gt;llm_usage: each model call with tokens and cost&lt;br&gt;kv: one-time budget alerts&lt;br&gt;&lt;font color='#7e22ce'&gt;no secrets stored here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="container">
          <mxGeometry x="16" y="370" width="508" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="ext-label" value="EXTERNAL SERVICES" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="240" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="github" value="&lt;b&gt;GitHub REST API&lt;/b&gt;&lt;br&gt;reads: open PRs, CI, reviews, comments&lt;br&gt;&lt;font color='#15803d'&gt;&lt;b&gt;one write: post a PR comment&lt;/b&gt;&lt;br&gt;only from the approval service&lt;/font&gt;&lt;br&gt;fine-grained token, one repository&lt;br&gt;15 s timeout; errors never hide as passing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#334155;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="84" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="&lt;b&gt;LLM API (OpenAI-compatible)&lt;/b&gt;&lt;br&gt;model + base URL are config&lt;br&gt;sees only compact tool results&lt;br&gt;never posts to GitHub" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#334155;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="220" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="slack-api" value="&lt;b&gt;Slack API (Socket Mode)&lt;/b&gt;&lt;br&gt;outbound WebSocket (no public URL)&lt;br&gt;approval cards as DMs to approvers" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#334155;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="316" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;&lt;font color='#15803d'&gt;HUMAN APPROVER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;sees the card: exact comment, PR, link, reason, who asked, expiry&lt;br&gt;decides in Slack (button) or on the web&lt;br&gt;(approver key / WEB_USERS). Nothing else can." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="410" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="secrets" value="&lt;b&gt;&lt;font color='#c2410c'&gt;WHERE SECRETS ARE KEPT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Platform secrets / environment variables only (&lt;font face='Courier New'&gt;fly secrets set&lt;/font&gt;, or a git-ignored &lt;font face='Courier New'&gt;.env&lt;/font&gt; locally). Never in git, never in the image, never in SQLite.&lt;br&gt;GITHUB_TOKEN, LLM_API_KEY, SLACK_BOT_TOKEN, SLACK_APP_TOKEN, WEB_USERS keys, WEB_ACCESS_KEY, WEB_APPROVER_KEY, MCP_TOKENS.&lt;br&gt;Approver identities: SLACK_APPROVER_USER_IDS and the web approver role/key. Keys compared in constant time; MCP clients logged by a hash of their token, not the token." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1090" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-slack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="slack" target="handlers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="web" target="handlers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="mcp" target="handlers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-h-agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="container" source="handlers" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-agent-tools" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;" edge="1" parent="container" source="agent" target="tools">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-tools-triage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="container" source="tools" target="triage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-propose" value="propose only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#15803d;fontColor=#15803d;fontStyle=1;fontSize=10;" edge="1" parent="container" source="agent" target="approval">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-read" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="tools" target="github">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-llm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="agent" target="llm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-digest" value="digest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="scheduler" target="slack-api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-socket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="slack-api" target="handlers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-human" value="presses Approve / Reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;endArrow=block;endFill=1;strokeColor=#15803d;fontColor=#15803d;fontStyle=1;fontSize=10;" edge="1" parent="1" source="human" target="approval">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-write" value="the only write to GitHub, only after approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontColor=#15803d;fontStyle=1;fontSize=11;" edge="1" parent="1" source="approval" target="github">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="392"/>
              <mxPoint x="1140" y="144"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
