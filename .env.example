# Copy to .env for local development. Never commit the real file.
# In production, set these as environment variables on the host.

# --- Slack (see README "Slack setup"; create the app from slack-app-manifest.yaml) ---
# Bot User OAuth Token (OAuth & Permissions), starts with xoxb-
SLACK_BOT_TOKEN=
# App-level token with scope connections:write (Basic Information), starts with xapp-
SLACK_APP_TOKEN=
# Comma-separated Slack member IDs (U01ABCDEF) allowed to chat. Empty = only approvers.
SLACK_ALLOWED_USER_IDS=
# true = every member of this Slack workspace may chat (handy for testers: no ids to collect).
# It never gives approval rights; only SLACK_APPROVER_USER_IDS can approve. Use it only in a
# workspace you control (invite-only, no guests, no Slack Connect channels). Default: false.
SLACK_ALLOW_ALL_MEMBERS=false
# Comma-separated Slack member IDs allowed to APPROVE actions (also allowed to chat).
# Copy yours: Slack profile -> three dots -> Copy member ID
SLACK_APPROVER_USER_IDS=
# Optional. Links Slack members to GitHub logins so /triage queue can show "waiting for YOUR review":
# SLACK_GITHUB_USERS=U01ABCDEF:octocat,U02GHIJKL:hubot
SLACK_GITHUB_USERS=
# Optional channel ID (C01ABCDEF) for the morning digest. Empty = a DM to every approver.
SLACK_DIGEST_CHANNEL_ID=

# --- GitHub ---
# Fine-grained token: Pull requests (read/write), Issues (read/write), Contents (read), Metadata (read)
GITHUB_TOKEN=
# Repository the agent works on, e.g. "octocat/hello-world"
GITHUB_REPO=

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Price per 1M tokens in USD, used by the budget guard
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Budget ---
MONTHLY_BUDGET_USD=50
# Fixed monthly hosting cost in USD (counted against the same budget)
HOSTING_COST_USD=7
# Max requests per person per day (the brief assumes ~20; this is the safety cap)
DAILY_REQUESTS_PER_USER=40

# --- Web / MCP ---
PORT=3000
# Public base URL of the deployment (used in links)
PUBLIC_BASE_URL=http://localhost:3000
# Web GUI keys (>= 16 chars, typed into the page's login box; never put them in a URL).
# Access key: read the queue, chat, ask for a comment. Cannot approve.
WEB_ACCESS_KEY=
# Approver key: additionally approve/reject on the web page. Must differ from the access key.
WEB_APPROVER_KEY=
# MCP endpoint: POST {PUBLIC_BASE_URL}/mcp with "Authorization: Bearer <token>".
# JSON map of token (16+ chars) -> role. Generate tokens with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   "reader"   read the queue / PRs and ask questions
#   "proposer" also create a comment REQUEST (a human still has to approve it)
# No MCP role can approve or post anything.
# Example: {"<token-1>":"reader","<token-2>":"proposer"}
MCP_TOKENS={}

# --- Scheduler ---
# Cron expression (server time zone). Default: 08:30 on weekdays
DIGEST_CRON=30 8 * * 1-5
TZ=Asia/Jerusalem

# --- Storage ---
DATABASE_PATH=./data/agent.sqlite
