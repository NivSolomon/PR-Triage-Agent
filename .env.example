# Copy to .env for local development. Never commit the real file.
# In production, set these as environment variables on the host.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot (empty = nobody)
TELEGRAM_ALLOWED_USER_IDS=
# Comma-separated Telegram user ids allowed to APPROVE actions (subset of the above)
APPROVER_TELEGRAM_IDS=
# Chat id that receives the scheduled digest
TELEGRAM_DIGEST_CHAT_ID=

# --- GitHub ---
# Fine-grained token: Pull requests (read/write), Issues (read/write), Contents (read), Metadata (read)
GITHUB_TOKEN=
# Repository the agent works on, e.g. "octocat/hello-world"
GITHUB_REPO=

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Price per 1M tokens in USD, used by the budget guard
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Budget ---
MONTHLY_BUDGET_USD=50
# Fixed monthly hosting cost in USD (counted against the same budget)
HOSTING_COST_USD=7

# --- Web / MCP ---
PORT=3000
# Public base URL of the deployment (used in links)
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret for the web GUI (sent as ?key=... or Authorization: Bearer ...)
WEB_ACCESS_KEY=
# JSON map of MCP client tokens to roles, e.g. {"tok_reader":"reader","tok_ops":"approver"}
MCP_TOKENS={}

# --- Scheduler ---
# Cron expression (server time zone). Default: 08:30 on weekdays
DIGEST_CRON=30 8 * * 1-5
TZ=Asia/Jerusalem

# --- Storage ---
DATABASE_PATH=./data/agent.sqlite
