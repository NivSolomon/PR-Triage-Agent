# Copy to .env for local development. Never commit the real file.
# In production, set these as environment variables on the host.

# --- Slack (see README "Slack setup"; create the app from slack-app-manifest.yaml) ---
# Bot User OAuth Token (OAuth & Permissions), starts with xoxb-
SLACK_BOT_TOKEN=
# App-level token with scope connections:write (Basic Information), starts with xapp-
SLACK_APP_TOKEN=
# Comma-separated Slack member IDs (U01ABCDEF) allowed to chat. Empty = only approvers.
SLACK_ALLOWED_USER_IDS=
# true = every member of this Slack workspace may chat AND Approve/Reject in Slack
# (handy for testers: a workspace invite is then enough; no ids to collect).
# People from other workspaces (Slack Connect) are still refused. Use it only in a
# workspace you control (invite-only, no guests). Default: false.
SLACK_ALLOW_ALL_MEMBERS=false
# Comma-separated Slack member IDs allowed to APPROVE actions (also allowed to chat).
# Copy yours: Slack profile -> three dots -> Copy member ID
SLACK_APPROVER_USER_IDS=
# Optional. Links Slack members to GitHub logins so /triage queue can show "waiting for YOUR review":
# SLACK_GITHUB_USERS=U01ABCDEF:octocat,U02GHIJKL:hubot
SLACK_GITHUB_USERS=
# Optional channel ID (C01ABCDEF) for the morning digest and, when SLACK_ALLOW_ALL_MEMBERS=true,
# the approval cards testers click. Empty = a DM to every named approver.
SLACK_DIGEST_CHANNEL_ID=

# --- GitHub ---
# Fine-grained token: Issues (read/write) for comments, Pull requests (read), Contents (read), Checks (read), Metadata (read).
# Do not grant Pull requests write: this app never merges, closes or edits a PR.
GITHUB_TOKEN=
# Repository the agent works on, e.g. "octocat/hello-world"
GITHUB_REPO=

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Price per 1M tokens in USD, used by the budget guard
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Budget ---
MONTHLY_BUDGET_USD=50
# Fixed monthly hosting cost in USD (counted against the same budget)
HOSTING_COST_USD=7
# Max requests per person per day (the brief assumes ~20; this is the safety cap)
DAILY_REQUESTS_PER_USER=40

# --- Web / MCP ---
PORT=3000
# Web GUI login (recommended): one key per person, so the audit trail says WHO approved and one key can be
# revoked alone. JSON map name -> {key (16+ chars, different for each person), role}.
#   "approver"  can approve/reject on the web page (the person is recorded by name, e.g. web:dana)
#   "reader"    can read, chat and ask for a comment; cannot approve
# Names: lowercase letters, digits, . _ -     Example:
#   WEB_USERS={"dana":{"key":"<key-1>","role":"approver","github":"octocat"},"lee":{"key":"<key-2>","role":"reader"}}
WEB_USERS={}
# Older, simpler alternative: two keys shared by everyone who holds them (the audit trail cannot tell them apart).
# Both still work next to WEB_USERS; leave blank if you use WEB_USERS only. Typed into the login box, never in a URL.
WEB_ACCESS_KEY=
WEB_APPROVER_KEY=
# Number of reverse proxies in front of the app: 1 on Fly.io, 0 when running locally.
TRUST_PROXY=0
# Wrong keys allowed per address (10 minutes) before it is paused. 0 = never pause, and only allowed when TRUST_PROXY=0.
AUTH_MAX_FAILURES=10
# MCP endpoint: POST https://<your-host>/mcp with "Authorization: Bearer <token>".
# JSON map of token (16+ chars) -> role. Generate tokens with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   "reader"   read the queue / PRs and ask questions
#   "proposer" also create a comment REQUEST (a human still has to approve it)
# No MCP role can approve or post anything.
# Example: {"<token-1>":"reader","<token-2>":"proposer"}
MCP_TOKENS={}

# --- Scheduler ---
# Cron expression (server time zone). Default: 08:30 Sunday–Friday (Israel work week)
DIGEST_CRON=30 8 * * 0-5
TZ=Asia/Jerusalem

# --- Storage ---
DATABASE_PATH=./data/agent.sqlite
