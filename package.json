{
  "name": "pr-triage-agent",
  "version": "0.1.0",
  "description": "AI agent that triages GitHub pull requests, answers from real data, and acts only after human approval.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "openai": "^7.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
